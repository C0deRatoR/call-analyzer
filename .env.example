# ============================================================
# ConvIQ environment configuration
# Copy this to `.env` and fill in the required values.
# ============================================================

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ---- Database (Postgres + pgvector) ----
DATABASE_URL=postgresql+asyncpg://conviq:conviq@localhost:5432/conviq

# ---- Redis (Celery broker + SSE pub/sub) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- LLM (Gemini) ----
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- HuggingFace ----
# Required to download pyannote.audio. Accept access for these gated models:
# https://huggingface.co/pyannote/speaker-diarization-3.1
# https://huggingface.co/pyannote/segmentation-3.0
# https://huggingface.co/pyannote/speaker-diarization-community-1
# Also used later to publish the fine-tuned dialogue-act classifier.
HF_TOKEN=
HF_USERNAME=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1

# ---- Whisper ----
# tiny | base | small | medium | large
WHISPER_MODEL_SIZE=small

# ---- Dialogue-act classifier ----
# Local artifact produced by scripts/train_dialogue_act.py.
DIALOGUE_ACT_MODEL=models/dialogue-act/distilbert-dailydialog-app-buckets
