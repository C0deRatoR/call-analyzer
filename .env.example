# ============================================================
# ConvIQ environment configuration
# Copy this to `.env` and fill in the required values.
# ============================================================

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ---- Database (Postgres + pgvector) ----
DATABASE_URL=postgresql+asyncpg://conviq:conviq@localhost:5432/conviq

# ---- Redis (Celery broker + SSE pub/sub) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- LLM (Gemini) ----
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# ---- HuggingFace ----
# Required to download pyannote.audio (accept the license at
# https://huggingface.co/pyannote/speaker-diarization-3.1 first) and to
# publish the fine-tuned dialogue-act classifier.
HF_TOKEN=
HF_USERNAME=

# ---- Langfuse (LLM observability) ----
# Self-hosted via Docker, or use https://cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Whisper ----
# tiny | base | small | medium | large
WHISPER_MODEL_SIZE=base
